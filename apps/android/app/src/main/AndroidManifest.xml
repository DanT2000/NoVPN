<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Тип службы: для VPN Google формально предлагает systemExempted, но он
         требует уже выданного согласия на VPN, иначе startForeground падает с
         SecurityException. specialUse рантайм-условий не имеет — так делают и
         другие клиенты. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Без снятия ограничений батареи оболочки усыпляют службу, и связь рвётся
         через несколько минут после выключения экрана. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Видимость чужих приложений (Android 11+). QUERY_ALL_PACKAGES намеренно НЕ
         запрашивается: Google разрешает его лишь антивирусам, файловым менеджерам
         и браузерам. Списка приложений с экрана запуска для разводки трафика
         достаточно. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NoVpnApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.NoVPN"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NoVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Кнопка «Добавить подписку» на странице панели: novpn://subscribe?url=… -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="novpn" />
            </intent-filter>
            <!-- Долгое нажатие на плитку в шторке открывает само приложение,
                 а не «О приложении». Без этого фильтра система ведёт в настройки. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.NoVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:stopWithTask="false">
            <!-- Обоснование типа specialUse для проверки в магазине. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_tunnel" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Метаданные SUPPORTS_ALWAYS_ON не объявляем намеренно: по умолчанию
                 она true, а значение false отключило бы «Постоянный VPN» целиком. -->
        </service>

        <!-- Плитка в шторке быстрых настроек: тот же щит с буквой N, что и в
             уведомлении. Состояние берёт из VpnBus, включает/выключает службу. -->
        <service
            android:name=".system.QuickTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_novpn"
            android:label="NoVPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <receiver
            android:name=".system.BootReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
