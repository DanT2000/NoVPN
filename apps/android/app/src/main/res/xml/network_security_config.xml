<?xml version="1.0" encoding="utf-8"?>
<!--
  Управляющий канал движка живёт на http://127.0.0.1:9893, а начиная с Android 9
  открытый HTTP запрещён приложению целиком — исключения для петли в системе нет.
  Без этого файла OkHttp отказывался бы соединяться, приложение не дожидалось бы
  ответа движка и объявляло «Движок не ответил за 15 секунд»: VPN не поднимался бы
  вообще, причём молча.

  Разрешаем открытый HTTP ТОЛЬКО для петли. Для всего остального (панель, списки,
  подписка) он по-прежнему запрещён: подписка содержит ключи, и ходить за ней по
  открытому каналу нельзя.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
