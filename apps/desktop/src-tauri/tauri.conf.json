{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoVPN",
  "version": "0.2.5",
  "identifier": "ru.appswire.novpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NoVPN",
        "width": 480,
        "height": 820,
        "minWidth": 440,
        "minHeight": 700,
        "maxWidth": 680,
        "maxHeight": 1150,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "NoVPN",
    "shortDescription": "NoVPN — доступ к нужным сайтам и приложениям",
    "longDescription": "NoVPN Desktop — доступ к нужным сайтам и приложениям без лишних вопросов.",
    "externalBin": [
      "bin/mihomo"
    ],
    "resources": {
      "bin/wintun.dll": "./wintun.dll",
      "bin/LICENSE-wintun.txt": "./LICENSE-wintun.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
