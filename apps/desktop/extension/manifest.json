{
  "manifest_version": 3,
  "name": "NoVPN",
  "version": "0.1.0",
  "description": "Выбирайте прямо на сайте, идёт он через VPN или напрямую. Правило сразу попадает в приложение NoVPN.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "NoVPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
