# ═══════════════════════════════════════════════════════════════
#  NoVPN — переменные окружения. Скопируйте в .env и заполните.
#  НЕ коммитьте .env (он в .gitignore). Здесь только имена и примеры.
# ═══════════════════════════════════════════════════════════════

# ── Секреты — ВСЕ НЕОБЯЗАТЕЛЬНЫ (панель заводит их сама) ──
# Оставьте пустыми — при первом старте панель сгенерирует ключ шифрования и сохранит
# его в /data/encryption.key (постоянный том), а секрет сессий выведет из него. Так
# установка работает «распаковал — и всё». Задавайте значения ниже, ТОЛЬКО если хотите
# контролировать секреты вручную (например, переносите базу между машинами).

# Ключ шифрования секретов в базе (SSH-пароли/ключи серверов, Telegram-токен,
# пароли прокси). Формат: 32 байта в hex (64 симв.) или base64, либо любая
# длинная строка. Сгенерировать:  openssl rand -hex 32
# ВАЖНО: если задали и панель им зашифровала данные — не менять (иначе не расшифрует).
ENCRYPTION_KEY=

# Секрет подписи сессий (cookie входа). Пусто → выводится из ключа шифрования.
# Сгенерировать:  openssl rand -hex 32
SESSION_SECRET=

# ── Публичный адрес и доступ ──

# Внешний адрес, по которому открывается панель — БАЗОВЫЙ URL для всех ссылок,
# которые NoVPN отдаёт пользователям (личные ссылки /k/…, подписки /sub/…).
# Задаётся ещё и в самой панели (Настройки → Адрес сайта); значение из панели
# имеет приоритет, это — резервное. Пример: https://panel.example.com
# Если указать без схемы, будет добавлен https://.
PUBLIC_URL=https://panel.example.com

# Стартовый пароль администратора при первом запуске (по умолчанию: admin).
# Панель попросит сменить его сразу после входа. Логина нет — вход только по паролю.
ADMIN_PASSWORD=admin

# ── Необязательные (есть разумные значения по умолчанию) ──

# NODE_ENV=production           # режим (production в проде)
# PORT=3000                     # порт панели внутри контейнера/хоста
# DATABASE_PATH=/data/database.sqlite   # путь к файлу базы (том!). В Docker уже задан
# COOKIE_SECURE=false           # true — только если TLS терминируется самим приложением
# TRUST_PROXY_HOPS=1            # число доверенных прокси перед панелью (traefik/nginx). 0 = напрямую
# SESSION_TTL_HOURS=24          # срок жизни сессии администратора
# APP_NAME=NoVPN                # имя в заголовке подписки Xray (Profile-Title)

# ── Сборка фронтенда (Vite), нужны только при локальной разработке ──
# VITE_API_BASE_URL=            # пусто = тот же origin (SPA отдаётся самой панелью)
# VITE_USE_MOCK=false           # true — демо без backend (mock-адаптер)
