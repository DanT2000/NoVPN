# ═══════════════════════════════════════════════════════════════
#  NoVPN — пример переменных окружения.
#  Скопируйте в .env и заполните значения. НЕ коммитьте .env в Git.
#  Здесь перечислены ТОЛЬКО имена переменных, без реальных значений.
# ═══════════════════════════════════════════════════════════════

# ── apps/manager (панель управления, control plane) ────────────
NODE_ENV=
PORT=
APP_NAME=
PUBLIC_URL=

# Учётная запись администратора (первичная инициализация).
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Криптография. SESSION_SECRET — подпись сессий.
# ENCRYPTION_KEY — 32-байтный ключ (base64/hex) для шифрования секретов в БД
# (Telegram-токены, proxy-пароли, SSH-ключи, agent enrollment secrets).
SESSION_SECRET=
ENCRYPTION_KEY=

# Хранилище.
DATABASE_PATH=
CONTENT_DIR=

# Регистрация агентов (control plane).
AGENT_ENROLLMENT_TTL_MIN=

# Совместимость со старым (legacy) push-агентом на время миграции.
# Для новых установок оставить пустыми / ENABLE_MOCK_AGENT=true в деве.
VPN_AGENT_URL=
VPN_AGENT_TOKEN=
ENABLE_MOCK_AGENT=

# ── apps/agent (NoVPN Agent на VPN-сервере) ────────────────────
AGENT_PORT=
CONTROL_PLANE_URL=
AGENT_ENROLLMENT_TOKEN=
AGENT_DATA_DIR=
XRAY_CONFIG_PATH=
AMNEZIAWG_CONFIG_DIR=
LOG_LEVEL=

# ── apps/web (сборка фронтенда, Vite) ──────────────────────────
# База API. Пусто = тот же origin (SPA отдаётся manager'ом).
VITE_API_BASE_URL=
# true — использовать mock-адаптер без backend; false — реальный API.
VITE_USE_MOCK=
