# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build output ──────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
apps/web/dist/
apps/manager/public/app/

# ── Environment & secrets (NEVER commit) ──────────────────────
.env
.env.*
!.env.example
*.local
.coolify.token
secrets/
*.secret

# SSH / crypto keys
*.pem
*.key
id_rsa*
id_ed25519*
*_ed25519
*_rsa
*.ppk
known_hosts

# ── Databases & persistent data ───────────────────────────────
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# ── Backups & dumps (NEVER commit) ────────────────────────────
backups/
*.dump
*.sql
*.sql.gz
*.tar.gz
*.tgz
*.bak

# ── VPN configs (NEVER commit) ────────────────────────────────
*.conf
*.vpn
*.ovpn
!**/content/**/*.conf

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
coverage/
.cache/
info.txt

# Локальные файлы приложений (заливаются в панель, НЕ в репозиторий)
*.apk
*.exe
*.AppImage
*.deb
*.ipa
*.dmg
v2rayTUN.webp
*.zip
*.msi
*.pkg
*.tar
*.tar.gz
*.7z

# Канал раздачи десктопа — эти бинарники ДОЛЖНЫ версионироваться (см. desktop/README.md)
!desktop/*.exe
!desktop/*.msi
!desktop/*.zip
!desktop/*.dmg
!desktop/*.AppImage
!desktop/*.deb
release/
*.novpn-keys
novpn-backup-*.novpnbak

# ── NoVPN Desktop (apps/desktop) — отдельный пакет, не npm-workspace ─────────
# Rust-артефакты (десятки ГБ) и Vite-выход не версионируем.
apps/desktop/src-tauri/target/
apps/desktop/dist/
apps/desktop/.tmp/
apps/desktop/.installtest/
# Движок и драйвер адаптера — бинарники из официальных релизов, качаются
# скриптом apps/desktop/scripts/fetch-engine.ps1 (версии закреплены там).
apps/desktop/src-tauri/bin/*.exe
apps/desktop/src-tauri/bin/*.dll
# Сгенерированные Tauri схемы ACL пересоздаются при сборке.
apps/desktop/src-tauri/gen/
