# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build output ──────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
apps/web/dist/
apps/manager/public/app/

# ── Environment & secrets (NEVER commit) ──────────────────────
.env
.env.*
!.env.example
*.local
.coolify.token
secrets/
*.secret

# SSH / crypto keys
*.pem
*.key
id_rsa*
id_ed25519*
*_ed25519
*_rsa
*.ppk
known_hosts

# ── Databases & persistent data ───────────────────────────────
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# ── Backups & dumps (NEVER commit) ────────────────────────────
backups/
*.dump
*.sql
*.sql.gz
*.tar.gz
*.tgz
*.bak

# ── VPN configs (NEVER commit) ────────────────────────────────
*.conf
*.vpn
*.ovpn
!**/content/**/*.conf

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
coverage/
.cache/
info.txt
